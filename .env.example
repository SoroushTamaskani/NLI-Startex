# Copy this file to .env.local and fill in the values.
# In Google AI Studio these are injected from the Secrets panel.

# Required. Your Gemini API key. It is only read by the server (server.ts)
# and is never sent to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional. Model used for Deep checks (thorough research with high thinking).
# GEMINI_MODEL="gemini-3.1-pro-preview"

# Optional. Model used for Quick checks and for turning reports into structured verdicts.
# If it isn't available on your key, NLI falls back to GEMINI_MODEL automatically.
# GEMINI_FAST_MODEL="gemini-3.6-flash"

# Optional. Port for the web server (AI Studio expects 3000).
# PORT=3000

# Optional. Largest file a user can attach, in MB.
# MAX_UPLOAD_MB=100

# Optional. Characters of document text sent to the model per attachment.
# MAX_DOCUMENT_CHARS=60000

# Optional. Per-IP limits, to protect the shared API key.
# RATE_LIMIT_WINDOW_MINUTES=10
# RATE_LIMIT_VERIFY=30
# RATE_LIMIT_UPLOAD=60

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
